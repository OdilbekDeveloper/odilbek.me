# Local development settings. Copy to `.env` and adjust; `.env` is git-ignored and never committed.
# Placeholders only. Production values are set in Railway, never in a file.
# The full inventory, including later phases, is in docs/DEPLOYMENT.md.

# ---------- Django ----------
# Any long random string for local use, e.g.
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_DEBUG=True
# DJANGO_LOG_LEVEL=INFO

# ---------- Database ----------
# Matches the local-only credentials of the `db` service in docker-compose.yml.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio
# If port 5432 is taken on this machine, set POSTGRES_PORT and change the port above to match.
# POSTGRES_PORT=5432

# ---------- Production only (set in Railway; listed here for reference) ----------
# Production never reads this file: every value comes from the real environment.
# DJANGO_SETTINGS_MODULE=config.settings.prod     already set by the Docker image
# DJANGO_ALLOWED_HOSTS must also include healthcheck.railway.app (docs/DEPLOYMENT.md, section 4)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=False
# DJANGO_CONN_MAX_AGE=60
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
